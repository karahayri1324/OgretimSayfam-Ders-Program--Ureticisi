# ── ÖğretimSayfam api4 köprü — ortam değişkenleri ────────────────────────────
# Bu dosyayı `.env` olarak kopyalayın ve doldurun. (cp .env.example .env)

# ── Sunucu ──
HOST=0.0.0.0
PORT=9000

# ── Veritabanı (SQLite) ──
# Boş bırakılırsa server/data/bridge.db kullanılır.
DB_PATH=

# ── JWT / oturum ──
# ÜRETİMDE MUTLAKA güçlü, rastgele bir değer verin (>=32 karakter).
#   python -c "import secrets; print(secrets.token_hex(32))"
# Boş bırakılırsa DB'de otomatik bir secret üretilir (restart'ta token'lar yaşar).
JWT_SECRET=
ACCESS_TOKEN_TTL_DAYS=30

# ── Upstream vLLM (KULLANICININ PC'sindeki model) ──
# VPS bu adrese köprüler. Ev PC'si NAT arkasında olduğundan bir tünel önerilir
# (Cloudflare Tunnel / reverse SSH / Tailscale). README "Upstream bağlantısı"na bakın.
# Tünel VPS'te localhost'a düşüyorsa: http://127.0.0.1:8000
UPSTREAM_VLLM_URL=http://127.0.0.1:8000
# vLLM'in --served-model-name ile yayınladığı model adı.
UPSTREAM_MODEL=ogretimsayfam-scheduler
# vLLM API anahtarı (vllm --api-key ile çalışıyorsa).
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_SEC=120
UPSTREAM_TEMPERATURE=0.1
UPSTREAM_MAX_TOKENS=1536

# ── system_prompt.txt (eğitimle byte-eş olmalı) ──
# Boş bırakılırsa server/system_prompt.txt kullanılır.
SYSTEM_PROMPT_PATH=

# ── Kota / demo varsayılanları (admin panelinden de değiştirilebilir) ──
DEFAULT_RATE_LIMIT_PER_HOUR=100

# ── Bootstrap admin (ilk açılışta oluşturulur) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── CORS ── (Electron çoğu zaman Origin: null gönderir; * en kolayı)
CORS_ORIGINS=*
